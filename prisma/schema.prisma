generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ManuscriptStatus {
  RECEIVED
  UNDER_REVIEW
  REVISION_REQUIRED
  ACCEPTED
  REJECTED
  PUBLISHED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EditorialMemberStatus {
  ACTIVE
  INACTIVE
}

enum EditorialDesignation {
  PATRON
  HONORARY_PATRON
  CHAIRPERSON_EDITORIAL_COUNCIL
  EDITOR_IN_CHIEF
  EXECUTIVE_EDITOR
  MANAGING_EDITOR
  DEPUTY_EDITOR
  ASSOCIATE_EDITOR
  ASSISTANT_EDITOR
  SECTION_EDITOR
  STATISTICAL_EDITOR
  RESEARCH_METHODOLOGY_EDITOR
  EDITORIAL_BOARD_MEMBER
  INTERNATIONAL_EDITORIAL_BOARD_MEMBER
  SCIENTIFIC_ADVISORY_BOARD_MEMBER
  ACADEMIC_ADVISORY_BOARD_MEMBER
  REVIEWER
}

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Manuscript {
  id              String @id @default(cuid())
  referenceNumber String @unique

  title       String
  articleType String
  subjectArea String

  abstractText String @db.Text
  keywords     String @db.Text

  correspondingAuthor String
  qualification       String?

  email String
  phone String?

  department  String?
  institution String?

  city    String?
  state   String?
  country String?

  orcid String?

  coAuthors String? @db.Text

  manuscriptFileUrl String?
  supportingFileUrl String?
  coverLetterUrl    String?

  originalWorkConfirmed    Boolean @default(false)
  notSubmittedElsewhere    Boolean @default(false)
  authorsApproved          Boolean @default(false)
  conflictsDeclared        Boolean @default(false)
  ethicsConfirmed          Boolean @default(false)
  journalPoliciesConfirmed Boolean @default(false)

  status ManuscriptStatus @default(RECEIVED)

  adminNotes    String? @db.Text
  reviewNotes   String? @db.Text
  revisionNotes String? @db.Text

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  publishedAt DateTime?

  article Article?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([submittedAt])
  @@index([email])
}

model Issue {
  id String @id @default(cuid())

  volumeNumber Int
  issueNumber  Int
  year         Int

  title       String?
  description String? @db.Text

  publicationDate DateTime?

  coverImageUrl String?

  published Boolean @default(false)
  current   Boolean @default(false)

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([volumeNumber, issueNumber, year])
  @@index([published])
  @@index([current])
}

model Article {
  id String @id @default(cuid())

  slug String @unique

  title       String
  articleType String
  subjectArea String?

  authors      String  @db.Text
  affiliations String? @db.Text

  correspondingAuthor String?
  correspondenceEmail String?

  abstractText String @db.Text
  keywords     String @db.Text

  introduction String? @db.Text
  methods      String? @db.Text
  results      String? @db.Text
  discussion   String? @db.Text
  conclusion   String? @db.Text

  acknowledgements String? @db.Text

  conflictOfInterest String? @db.Text
  fundingStatement   String? @db.Text
  ethicsStatement    String? @db.Text

  referencesText String? @db.Text

  doi  String? @unique
  issn String?

  startPage String?
  endPage   String?

  receivedDate  DateTime?
  acceptedDate  DateTime?
  publishedDate DateTime?

  pdfUrl String?

  status ArticleStatus @default(DRAFT)

  featured Boolean @default(false)

  manuscriptId String?     @unique
  manuscript   Manuscript? @relation(fields: [manuscriptId], references: [id], onDelete: SetNull)

  issueId String?
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([issueId])
  @@index([publishedDate])
}

model EditorialMember {
  id String @id @default(cuid())

  fullName       String
  qualifications String?

  editorialDesignation EditorialDesignation

  specialty               String?
  professionalDesignation String?

  department  String?
  institution String?

  city    String?
  state   String?
  country String?

  email String?

  orcidUrl         String?
  googleScholarUrl String?
  researchGateUrl  String?

  biography         String? @db.Text
  researchInterests String? @db.Text

  photoUrl String?

  displayOrder Int @default(0)

  status EditorialMemberStatus @default(ACTIVE)

  showOnWebsite Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([editorialDesignation])
  @@index([displayOrder])
  @@index([status])
}

model JournalSettings {
  id String @id @default(cuid())

  journalName String @default("International Journal of Electro-Homoeopathy & Research")

  abbreviation String @default("IJER")

  issnPrint  String?
  issnOnline String?

  publisherName String?

  email      String?
  phone      String?
  address    String? @db.Text
  city       String?
  state      String?
  country    String?
  postalCode String?

  websiteUrl String?

  publicationFrequency String?

  aimsAndScope String? @db.Text

  copyrightText String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
